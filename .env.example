# taskq-api — environment variables
# Source: SPEC.md §5.1 (canonical)
# This file declares every TASKQ_* env var the application reads.
# Copy to `.env` and edit per environment. Do NOT commit `.env` (gitignored).

# ───── Database ─────
# SQLAlchemy connection URL. Default: SQLite for dev. Production: postgresql://...
# NB: must NOT appear in any log line or /v1/metrics output (NFR-04).
TASKQ_DB_URL=sqlite:///./taskq.db
# Pool size; pool_pre_ping=True is hard-coded (FR-06).
TASKQ_DB_POOL_SIZE=5

# ───── Task execution (FR-08 / NFR-05) ─────
# Wall-clock budget for one subprocess task (seconds).
TASKQ_TASK_TIMEOUT=10.0
# Background-execution concurrency ceiling; new tasks queue beyond this.
TASKQ_MAX_CONCURRENT=8
# Graceful-drain window on shutdown (seconds); in-flight beyond this are marked interrupted.
TASKQ_DRAIN_TIMEOUT=30.0

# ───── Rate limit (FR-05) ─────
# Token-bucket capacity per token.
TASKQ_RATE_BURST=20
# Token-bucket refill rate per token (tokens/sec).
TASKQ_RATE_PER_SEC=5.0

# ───── HTTP / CORS ─────
# Comma-separated allow-list. Empty = deny all origins (NFR-02 default).
TASKQ_CORS_ORIGINS=
# Bind address. Default refuses external exposure.
TASKQ_HOST=127.0.0.1
# Bind port.
TASKQ_PORT=8000

# ───── Logging ─────
# One of: DEBUG, INFO, WARNING, ERROR.
TASKQ_LOG_LEVEL=INFO
# One of: json, text.
TASKQ_LOG_FORMAT=json
